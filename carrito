<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sara - Carrito de Compras</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary fs-3" href="index.html"><i class="bi bi-bag-heart-fill me-1"></i>Sara</a>
            <div class="ms-auto">
                <a href="galeria.html" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left"></i> Seguir Comprando</a>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <h2 class="fw-bold mb-4"><i class="bi bi-cart3"></i> Carrito de Compras</h2>

        <div class="row g-4">
            <!-- TABLA DE PRODUCTOS EN CARRITO -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-3">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th>Precio Unitario</th>
                                    <th>Cantidad</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Producto 1 -->
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://picsum.photos/id/1027/80/80" class="rounded me-3" alt="Producto">
                                            <div>
                                                <h6 class="mb-0 fw-bold">Vestido Casual Floral</h6>
                                                <small class="text-muted">Talla: M</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>$699.00</td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center" value="1" style="width: 60px;">
                                    </td>
                                    <td class="fw-bold text-primary">$699.00</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                                <!-- Producto 2 -->
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://picsum.photos/id/1062/80/80" class="rounded me-3" alt="Producto">
                                            <div>
                                                <h6 class="mb-0 fw-bold">Bolso de Mano Cuero</h6>
                                                <small class="text-muted">Color: Café</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>$899.00</td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center" value="1" style="width: 60px;">
                                    </td>
                                    <td class="fw-bold text-primary">$899.00</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Botón para seguir comprando -->
                    <div class="d-flex justify-content-between mt-3">
                        <a href="galeria.html" class="btn btn-light"><i class="bi bi-arrow-left"></i> Seguir Comprando</a>
                        <button class="btn btn-outline-secondary">Actualizar Carrito</button>
                    </div>
                </div>
            </div>

            <!-- RESUMEN DEL PEDIDO -->
            <div class="col-lg-4">
                <!-- Cupón de Descuento -->
                <div class="card border-0 shadow-sm p-3 mb-3">
                    <h6 class="fw-bold mb-2"><i class="bi bi-ticket-perforated"></i> ¿Tienes un cupón?</h6>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Ej. SARA15">
                        <button class="btn btn-outline-primary" type="button">Aplicar</button>
                    </div>
                </div>

                <!-- Calculadora de Envío -->
                <div class="card border-0 shadow-sm p-3 mb-3">
                    <h6 class="fw-bold mb-2"><i class="bi bi-truck"></i> Opciones de Envío</h6>
                    <select class="form-select form-select-sm mb-2">
                        <option selected>Envío Estándar (3-5 días) - $99.00</option>
                        <option>Envío Express (1-2 días) - $180.00</option>
                        <option>Recoger en Tienda Sara - Gratis</option>
                    </select>
                </div>

                <!-- Desglose de Totales -->
                <div class="card border-0 shadow-sm p-3">
                    <h5 class="fw-bold mb-3">Resumen del Pedido</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>$1,598.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Envío</span>
                        <span>$99.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>IVA (16%)</span>
                        <span>$271.52</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <strong class="fs-5">Total</strong>
                        <strong class="fs-5 text-primary">$1,968.52</strong>
                    </div>

                    <button class="btn btn-success btn-lg w-100 fw-bold"><i class="bi bi-credit-card me-2"></i>Proceder al Pago</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0 small">&copy; 2026 Sara. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
