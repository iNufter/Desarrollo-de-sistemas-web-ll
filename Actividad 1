CREATE DATABASE TiendaSara;
GO

USE TiendaSara;
GO

--Creacion de la tabla Categorias
CREATE TABLE Categorias (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Descripcion VARCHAR(100) NOT NULL
);

--Creacion de la tabla Marcas
CREATE TABLE Marcas (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Descripcion VARCHAR(100) NOT NULL
);

-- Creación de la tabla Productos
CREATE TABLE Productos (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Descripcion VARCHAR(150) NOT NULL,
    Precio DECIMAL(10, 2) NOT NULL CHECK (Precio >= 0),
    Cantidad INT NOT NULL CHECK (Cantidad >= 0),
    idCategoria INT NOT NULL,
    idMarca INT NOT NULL,
    CONSTRAINT FK_Producto_Categoria FOREIGN KEY (idCategoria) REFERENCES Categorias(Id),
    CONSTRAINT FK_Producto_Marca FOREIGN KEY (idMarca) REFERENCES Marcas(Id)
);

-- Creación de la tabla Carrito
CREATE TABLE Carrito (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    FolioVenta VARCHAR(50) NOT NULL UNIQUE,
    TotalCompra DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
    Estatus VARCHAR(30) NOT NULL DEFAULT 'Activo',
    Fecha DATETIME NOT NULL DEFAULT GETDATE()
);

-- Creación de la tabla CarritoDetalle
CREATE TABLE CarritoDetalle (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    IdCarrito INT NOT NULL,
    IdProducto INT NOT NULL,
    Cantidad INT NOT NULL CHECK (Cantidad > 0),
    Subtotal DECIMAL(10, 2) NOT NULL CHECK (Subtotal >= 0),
    CONSTRAINT FK_Detalle_Carrito FOREIGN KEY (IdCarrito) REFERENCES Carrito(Id),
    CONSTRAINT FK_Detalle_Producto FOREIGN KEY (IdProducto) REFERENCES Productos(Id)
);
