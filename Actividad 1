-- 1. Consultar los productos con sus marcas y sus categorías
SELECT 
    p.Id AS IdProducto,
    p.Descripcion AS Producto,
    p.Precio,
    p.Cantidad,
    c.Descripcion AS Categoria,
    m.Descripcion AS Marca
FROM Productos p
INNER JOIN Categorias c ON p.idCategoria = c.Id
INNER JOIN Marcas m ON p.idMarca = m.Id;

-- 2. Consultar los carritos con sus carritos detalle y sus productos
SELECT 
    car.Id AS IdCarrito,
    car.FolioVenta,
    car.Estatus,
    cd.Cantidad AS CantidadEnCarrito,
    cd.Subtotal,
    p.Descripcion AS Producto
FROM Carrito car
INNER JOIN CarritoDetalle cd ON car.Id = cd.IdCarrito
INNER JOIN Productos p ON cd.IdProducto = p.Id;

-- 3. Consultar los carritos con sus carritos detalle, productos, marcas y categorías
SELECT 
    car.FolioVenta,
    car.Estatus,
    car.Fecha,
    p.Descripcion AS Producto,
    cd.Cantidad,
    cd.Subtotal,
    m.Descripcion AS Marca,
    c.Descripcion AS Categoria
FROM Carrito car
INNER JOIN CarritoDetalle cd ON car.Id = cd.IdCarrito
INNER JOIN Productos p ON cd.IdProducto = p.Id
INNER JOIN Marcas m ON p.idMarca = m.Id
INNER JOIN Categorias c ON p.idCategoria = c.Id;
