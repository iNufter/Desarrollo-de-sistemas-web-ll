<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sara - Galería de Productos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary fs-3" href="index.html"><i class="bi bi-bag-heart-fill me-1"></i>Sara</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navGaleria"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navGaleria">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                    <li class="nav-item"><a class="nav-link" href="index.html">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link active" href="galeria.html">Catálogo / Productos</a></li>
                </ul>
                <a href="carrito.html" class="btn btn-light position-relative">
                    <i class="bi bi-cart3 fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">3</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <div class="container my-4">
        <!-- Encabezado de catálogo -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
            <div>
                <h2 class="fw-bold mb-0">Catálogo de Productos</h2>
                <small class="text-muted">Mostrando 12 de 48 productos</small>
            </div>
            <!-- Ordenar Por -->
            <div class="d-flex align-items-center mt-3 mt-md-0">
                <label for="ordenar" class="me-2 text-nowrap fw-semibold small">Ordenar por:</label>
                <select class="form-select form-select-sm" id="ordenar">
                    <option selected>Relevancia</option>
                    <option value="1">Precio: de menor a mayor</option>
                    <option value="2">Precio: de mayor a menor</option>
                    <option value="3">Más populares</option>
                </select>
            </div>
        </div>

        <div class="row">
            <!-- COLUMNA IZQUIERDA: FILTROS -->
            <aside class="col-lg-3 mb-4">
                <div class="card border-0 shadow-sm p-3">
                    <h5 class="fw-bold mb-3"><i class="bi bi-funnel"></i> Filtros</h5>
                    
                    <!-- Categorías -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Categoría</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cat1" checked>
                            <label class="form-check-label" for="cat1">Ropa Dama (24)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cat2">
                            <label class="form-check-label" for="cat2">Ropa Caballero (12)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cat3">
                            <label class="form-check-label" for="cat3">Accesorios (8)</label>
                        </div>
                    </div>

                    <!-- Precio -->
                    <div class="mb-3">
                        <label for="precioRango" class="form-label fw-semibold">Precio Máximo: <span id="precioValor">$2,000</span></label>
                        <input type="range" class="form-range" min="100" max="5000" step="100" id="precioRango">
                    </div>

                    <!-- Marca -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Marca</label>
                        <select class="form-select form-select-sm">
                            <option selected>Todas las marcas</option>
                            <option>Sara Basic</option>
                            <option>Sara Premium</option>
                            <option>Sara Urban</option>
                        </select>
                    </div>

                    <!-- Color -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Color</label>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-dark rounded-circle p-2"></button>
                            <button class="btn btn-sm btn-primary rounded-circle p-2"></button>
                            <button class="btn btn-sm btn-danger rounded-circle p-2"></button>
                            <button class="btn btn-sm btn-warning rounded-circle p-2"></button>
                        </div>
                    </div>

                    <button class="btn btn-outline-primary btn-sm w-100">Limpiar Filtros</button>
                </div>
            </aside>

            <!-- COLUMNA DERECHA: GRID DE PRODUCTOS -->
            <main class="col-lg-9">
                <div class="row g-4">
                    <!-- Producto 1 -->
                    <div class="col-6 col-md-4">
                        <div class="card h-100 border-0 shadow-sm position-relative">
                            <span class="badge bg-danger position-absolute top-0 start-0 m-2">-20%</span>
                            <img src="https://picsum.photos/id/1027/300/220" class="card-img-top" alt="Producto">
                            <div class="card-body d-flex flex-column">
                                <h6 class="fw-bold mb-1">Vestido Casual Floral</h6>
                                <p class="text-muted small mb-2">Colección Verano</p>
                                <div class="mt-auto">
                                    <div class="mb-2">
                                        <span class="fw-bold text-primary fs-5">$699.00</span>
                                        <span class="text-muted text-decoration-line-through small">$875.00</span>
                                    </div>
                                    <a href="carrito.html" class="btn btn-sm btn-primary w-100"><i class="bi bi-cart-plus"></i> Agregar</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 2 -->
                    <div class="col-6 col-md-4">
                        <div class="card h-100 border-0 shadow-sm position-relative">
                            <span class="badge bg-success position-absolute top-0 start-0 m-2">Nuevo</span>
                            <img src="https://picsum.photos/id/1059/300/220" class="card-img-top" alt="Producto">
                            <div class="card-body d-flex flex-column">
                                <h6 class="fw-bold mb-1">Chaqueta Denim Clásica</h6>
                                <p class="text-muted small mb-2">Moda Urbana</p>
                                <div class="mt-auto">
                                    <div class="mb-2"><span class="fw-bold text-primary fs-5">$1,299.00</span></div>
                                    <a href="carrito.html" class="btn btn-sm btn-primary w-100"><i class="bi bi-cart-plus"></i> Agregar</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 3 -->
                    <div class="col-6 col-md-4">
                        <div class="card h-100 border-0 shadow-sm position-relative">
                            <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">Popular</span>
                            <img src="https://picsum.photos/id/1062/300/220" class="card-img-top" alt="Producto">
                            <div class="card-body d-flex flex-column">
                                <h6 class="fw-bold mb-1">Bolso de Mano Cuero</h6>
                                <p class="text-muted small mb-2">Accesorios Sara</p>
                                <div class="mt-auto">
                                    <div class="mb-2"><span class="fw-bold text-primary fs-5">$899.00</span></div>
                                    <a href="carrito.html" class="btn btn-sm btn-primary w-100"><i class="bi bi-cart-plus"></i> Agregar</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 4 -->
                    <div class="col-6 col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <img src="https://picsum.photos/id/21/300/220" class="card-img-top" alt="Producto">
                            <div class="card-body d-flex flex-column">
                                <h6 class="fw-bold mb-1">Calzado Urbano Blanco</h6>
                                <p class="text-muted small mb-2">Calzado Unisex</p>
                                <div class="mt-auto">
                                    <div class="mb-2"><span class="fw-bold text-primary fs-5">$1,150.00</span></div>
                                    <a href="carrito.html" class="btn btn-sm btn-primary w-100"><i class="bi bi-cart-plus"></i> Agregar</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 5 -->
                    <div class="col-6 col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <img src="https://picsum.photos/id/338/300/220" class="card-img-top" alt="Producto">
                            <div class="card-body d-flex flex-column">
                                <h6 class="fw-bold mb-1">Gafas de Sol Elegantes</h6>
                                <p class="text-muted small mb-2">Protección UV400</p>
                                <div class="mt-auto">
                                    <div class="mb-2"><span class="fw-bold text-primary fs-5">$450.00</span></div>
                                    <a href="carrito.html" class="btn btn-sm btn-primary w-100"><i class="bi bi-cart-plus"></i> Agregar</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Producto 6 -->
                    <div class="col-6 col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <img src="https://picsum.photos/id/1005/300/220" class="card-img-top" alt="Producto">
                            <div class="card-body d-flex flex-column">
                                <h6 class="fw-bold mb-1">Suéter Tejido Invierno</h6>
                                <p class="text-muted small mb-2">Abrigo Casual</p>
                                <div class="mt-auto">
                                    <div class="mb-2"><span class="fw-bold text-primary fs-5">$780.00</span></div>
                                    <a href="carrito.html" class="btn btn-sm btn-primary w-100"><i class="bi bi-cart-plus"></i> Agregar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PAGINACIÓN -->
                <nav class="mt-5">
                    <ul class="pagination justify-content-center">
                        <li class="page-item disabled"><a class="page-link">Anterior</a></li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#">Siguiente</a></li>
                    </ul>
                </nav>
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0 small">&copy; 2026 Sara. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
